[Unit]
Description=DCA agent (Angel One) - paper-live soak
Documentation=https://github.com/local/crypto-agent
# Wait for real network, not just the interface, so the first login doesn't fail.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dca
Group=dca
WorkingDirectory=/opt/crypto-agent

# Credentials + soak config. systemd reads plain KEY=VALUE (no `export`, no quotes).
EnvironmentFile=/opt/crypto-agent/.env
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
# Soak settings (override anything in .env). Remove these to run the .env defaults.
Environment=DRY_RUN=true
Environment=DEPLOY_MODE=schedule
Environment=DCA_START=8000
Environment=DCA_AMOUNT=500

ExecStart=/opt/crypto-agent/.venv/bin/python -u equity_agent/dca_agent.py --paper-live

# Survive crashes, network drops and broker outages; never give up during a 2-week soak.
Restart=always
RestartSec=30
StartLimitIntervalSec=0

StandardOutput=append:/var/log/dca-agent/agent.log
StandardError=append:/var/log/dca-agent/agent.log

# Modest hardening: it only needs its own directory and outbound HTTPS.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crypto-agent /var/log/dca-agent

[Install]
WantedBy=multi-user.target
